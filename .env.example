# Public URLs
STORE_PUBLIC_URL=https://eter-niu.com
COCINA_PUBLIC_URL=https://cocina.eter-niu.com
BIENESTAR_PUBLIC_URL=https://bienestar.eter-niu.com
NEXT_PUBLIC_STORE_URL=https://eter-niu.com
NEXT_PUBLIC_COCINA_URL=https://cocina.eter-niu.com
NEXT_PUBLIC_BIENESTAR_URL=https://bienestar.eter-niu.com
NEXT_PUBLIC_TOOLS_API_URL=https://eter-niu.com
NEXT_PUBLIC_BRAND_URL=https://www.eter-niu.com
STOREFRONT_PORT_MAPPING=127.0.0.1:18214:3000

# Medusa
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-store
REDIS_URL=redis://redis:6379
STORE_CORS=http://localhost:3000,https://shop.b2b.com.ec,https://cocina.b2b.com.ec,https://bienestar.b2b.com.ec
ADMIN_CORS=http://localhost:9000,https://shop.b2b.com.ec,https://cocina.b2b.com.ec,https://bienestar.b2b.com.ec,https://adminshop.b2b.com.ec
AUTH_CORS=http://localhost:9000,https://shop.b2b.com.ec,https://cocina.b2b.com.ec,https://bienestar.b2b.com.ec,https://adminshop.b2b.com.ec
JWT_SECRET=change-me
COOKIE_SECRET=change-me
MEDUSA_RUN_MIGRATIONS_ON_START=false
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_API_KEY=
MEDUSA_INTERNAL_URL=http://medusa-api:9000

# Ecommerce tools
TOOLS_PORT=8787
TOOLS_DATA_DIR=/data
CRM_BACKEND=medusa
ALLOW_DEMO_CATALOG=false
TOOLS_API_TOKEN=change-me
MEDUSA_STORE_API_URL=http://medusa-api:9000
MEDUSA_ADMIN_API_URL=http://medusa-api:9000
ECOMMERCE_TAX_RATE=0.15
WHATSAPP_SELLER_NUMBER=0987135207
NEXT_PUBLIC_WHATSAPP_SELLER_NUMBER=0987135207
REVIEWS_API_TOKEN=

# Datafast sandbox for certification review. Keep the token only in Coolify.
DATAFAST_ENV=test
DATAFAST_DRY_RUN=true
DATAFAST_ENTITY_ID=
DATAFAST_ACCESS_TOKEN=
DATAFAST_MID=
DATAFAST_TID=
DATAFAST_ECOMMERCE_ID=
DATAFAST_SERVICE_PROVIDER_ID=
DATAFAST_CUSTOMER_NAME=ETERNIU

# Transferencia bancaria (la otra forma de pago). Los valores reales van solo en
# Coolify: este repo es público. Sin ellos, /tools/payment-methods responde
# configured=false y Vicky escala a un humano en vez de dictar una cuenta.
BANK_TRANSFER_ENABLED=true
BANK_NAME=Banco Pichincha
BANK_ACCOUNT_HOLDER=
BANK_ACCOUNT_TAX_ID=
BANK_ACCOUNT_TYPE=Ahorros
BANK_ACCOUNT_NUMBER=
BRAND_INSTAGRAM_URL=https://instagram.com/eter.niu


# Meta catalog and organic publishing
META_CATALOG_BRAND=Eter Niu Cocina
META_ENV_PATH=/run/secrets/meta_env
META_API_VERSION=v23.0
NEXT_PUBLIC_PIXEL_ENABLED=false
PIXEL_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_DATASET_ID=
META_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
NEXT_PUBLIC_PIXEL_CONSENT_MODE=banner
