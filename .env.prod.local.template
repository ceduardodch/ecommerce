# Credenciales de SOLO LECTURA para inspeccionar producción.
#
# Copia este archivo a `.env.prod.local` (ya está en .gitignore) y llena los
# valores. Nunca pegues estos valores en un chat ni los commitees.
#
#   cp .env.prod.local.template .env.prod.local
#
# Se usa con `node scripts/prod-inspect.mjs <subcomando>`.

# --- Medusa Admin API -------------------------------------------------------
# URL base del admin en producción.
PROD_ADMIN_URL=https://admin.eter-niu.com

# Secret API key del admin de Medusa (empieza con `sk_`).
# Cómo crearla: admin.eter-niu.com/app > Settings > Secret API Keys > Create.
# Las rutas /admin aceptan este tipo de llave vía HTTP Basic, así que NO hace
# falta compartir tu usuario ni tu contraseña. Es revocable en un clic.
PROD_ADMIN_API_KEY=

# --- Meta WhatsApp Cloud API (opcional) -------------------------------------
# Solo si quieres validar el estado de entrega directamente contra Meta en vez
# de contra los eventos que ya guarda el CRM vía webhook.
# El token necesita permiso de lectura sobre la cuenta de WhatsApp Business.
META_WABA_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v23.0
